# No provider is required to explore repository analysis and the UI.
# Set these only after choosing a provider implementation.
APP_ENV=development
MAX_REPOSITORY_SIZE_MB=20
MAX_REPOSITORY_FILES=1000
MAX_AGENT_ITERATIONS=5
TEST_TIMEOUT_SECONDS=120
WORKSPACE_ROOT=./data/workspaces
SANDBOX_IMAGE=agentic-python-sandbox
SANDBOX_NETWORK=false
