# No provider is required to explore repository analysis and the UI.
# Set these only after choosing a provider implementation.
APP_ENV=development
MAX_REPOSITORY_SIZE_MB=20
MAX_REPOSITORY_FILES=1000
MAX_AGENT_ITERATIONS=5
TEST_TIMEOUT_SECONDS=120
WORKSPACE_ROOT=./data/workspaces
SANDBOX_IMAGE=agentic-python-sandbox
SANDBOX_NETWORK=false
DATABASE_PATH=./data/app.db

# Embeddings are routed independently from coding models. Set a provider name
# plus its API endpoint/key; the endpoint must return a JSON list of vectors.
EMBEDDING_PROVIDER_PRIMARY=
EMBEDDING_PROVIDER_FALLBACK=
HUGGINGFACE_EMBEDDING_API_KEY=
HUGGINGFACE_EMBEDDING_URL=
HUGGINGFACE_EMBEDDING_MODEL=
VECTOR_STORE_PATH=./data/vector_store

# Public-demo limits
MAX_CONCURRENT_TASKS=2
REQUEST_LIMIT_PER_MINUTE=120
WORKSPACE_TTL_HOURS=24
DEPENDENCY_PREPARE_TIMEOUT_SECONDS=600
# Configure one or both providers. Keep these values out of source control.
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
MISTRAL_API_KEY=
MISTRAL_MODEL=codestral-latest
